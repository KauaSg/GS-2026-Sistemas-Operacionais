# Global Solution 2026.2 - TransitoClaro - Operating Systems
# Copie para /etc/transitoclaro/so.env e ajuste APENAS na sua VM de laboratório.

# Infraestrutura
VM_HOSTNAME="transitoclaro-vm"
DNS_SERVERS="1.1.1.1 8.8.8.8"
# IP via DHCP (padrão seguro para VM). Para IP fixo, consulte o README.
USAR_IP_FIXO="nao"
INTERFACE_REDE=""
IP_FIXO_CIDR=""                # Exemplo: 192.168.56.30/24
GATEWAY_IPV4=""                # Exemplo: 192.168.56.1

# Aplicação CitizenTech
APP_REPO_URL="https://github.com/PietroVP0777/PietroVP0777-Gs_2026_Cs.git"
APP_REF="main"
# Se o GitHub estiver privado/inacessível, informe a pasta do projeto C# já copiada para a VM:
APP_SOURCE_DIR=""               # Exemplo: /home/aluno/Gs_2026_Cs
APP_PORT="5000"
APP_BIND_IP="127.0.0.1"         # Não expõe a API sem autenticação na rede.

# Monitoramento (porcentagens)
LIMITE_CPU="80"
LIMITE_RAM="80"
LIMITE_DISCO="85"
INTERVALO_MONITORAMENTO="15"    # Segundos
